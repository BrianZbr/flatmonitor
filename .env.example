# FlatMonitor Local Testing Environment Variables
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will NOT be committed

# Cloudflare R2 Credentials
FLATMONITOR_R2_ACCOUNT_ID=your_account_id_here
FLATMONITOR_R2_ACCESS_KEY_ID=your_access_key_id_here
FLATMONITOR_R2_SECRET_ACCESS_KEY=your_secret_access_key_here
FLATMONITOR_R2_BUCKET_NAME=your_bucket_name_here

# Optional: Custom domain for R2 public access
# FLATMONITOR_R2_PUBLIC_DOMAIN=https://status.yourdomain.com

# AWS S3 Credentials (if using S3 instead of R2)
# FLATMONITOR_AWS_ACCESS_KEY_ID=your_aws_access_key
# FLATMONITOR_AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# FLATMONITOR_S3_BUCKET_NAME=your_s3_bucket_name

# Optional: General FlatMonitor settings
# These use FLATMONITOR_ prefix as they are app-specific
# FLATMONITOR_CONFIG=/app/config/domains.yaml
# FLATMONITOR_DATA_DIR=data/
# FLATMONITOR_OUTPUT_DIR=public/
# FLATMONITOR_WORKERS=10
